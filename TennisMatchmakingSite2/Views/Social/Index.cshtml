@model List<TennisMatchmakingSite2.Models.NotificationModel>
    @{
    ViewData["Title"] = "Social";
    var currentUserId = Context.Session.GetString("UserId");
    var currentTheme = Context.Session.GetString("Theme") ?? "Wimbledon";
    }

    <div id="theme-data" data-theme="@currentTheme" class="hidden"></div>

    <div class="container mx-auto px-4 pb-24">
        <div class="mt-6">
            <h1 class="text-2xl sm:text-3xl font-bold mb-6">Social Hub</h1>

            <!-- Navigation Cards - Redesigned -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
                <!-- Friends Button -->
                <a href="@Url.Action("Friends", "Social")"
                   class="bg-white rounded-lg shadow-sm hover:shadow transition-all duration-300 overflow-hidden theme-card">
                    <div class="flex items-center p-3 sm:p-4">
                        <div class="flex-shrink-0 mr-2 bg-gradient-to-br from-blue-400 to-blue-600 text-white p-1.5 rounded-md">
                            <i class="fas fa-user-friends text-xs"></i>
                        </div>
                        <div>
                            <h3 class="font-medium text-sm text-gray-800">Friends</h3>
                            <p class="text-gray-500 text-xs hidden sm:block">View contacts</p>
                        </div>
                    </div>
                </a>

                <!-- Messages Button -->
                <a href="@Url.Action("Messages", "Social")"
                   class="bg-white rounded-lg shadow-sm hover:shadow transition-all duration-300 overflow-hidden theme-card">
                    <div class="flex items-center p-3 sm:p-4">
                        <div class="flex-shrink-0 mr-2 bg-gradient-to-br from-indigo-400 to-indigo-600 text-white p-1.5 rounded-md">
                            <i class="fas fa-comment-alt text-xs"></i>
                        </div>
                        <div>
                            <h3 class="font-medium text-sm text-gray-800">Messages</h3>
                            <p class="text-gray-500 text-xs hidden sm:block">View chats</p>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Latest Notifications Card - Redesigned -->
            <div class="bg-white rounded-xl shadow-md overflow-hidden">
                <div class="theme-header rounded-t-xl p-5">
                    <div class="flex items-center justify-between">
                        <h2 class="text-xl font-bold theme-text">Recent Notifications</h2>
                        @if (Model.Any(n => !n.IsRead))
                    {
                        <span class="inline-flex items-center justify-center px-3 py-1 rounded-full text-xs font-medium bg-white bg-opacity-20 text-white">
                            @Model.Count(n => !n.IsRead) new
                        </span>
                    }
                    </div>
                </div>

                @if (!Model.Any())
            {
                <div class="flex flex-col items-center justify-center py-16 px-4">
                    <div class="bg-gray-100 rounded-full p-4 mb-4">
                        <i class="fas fa-bell-slash text-3xl text-gray-400"></i>
                    </div>
                    <p class="text-gray-500 text-center">You don't have any notifications yet.</p>
                    <p class="text-gray-400 text-sm text-center mt-2">When you receive notifications, they'll appear here.</p>
                </div>
            }
            else
            {
                <div id="notifications-container" class="divide-y divide-gray-100 max-h-[70vh] overflow-y-auto">
                    @foreach (var notification in Model)
                    {
                    <div class="notification-item p-4 hover:bg-gray-50 transition-colors duration-200 @(!notification.IsRead ? "bg-blue-50" : "")"
                         id="notification-@notification.Id"
                         data-notification-id="@notification.Id">

                        @switch (notification.Type)
                            {
                                case "match_edited":
                        <div class="flex items-start">
                            <div class="flex-shrink-0 mr-3 mt-1">
                                <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center">
                                    <i class="fas fa-calendar-check text-blue-500"></i>
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex justify-between mb-1">
                                    <h3 class="text-base font-semibold text-gray-900 truncate">Match Updated</h3>
                                    <span class="text-xs text-gray-500">
                                        @notification.CreatedAt.ToString("MMM d, h:mm tt")
                                        @if (!notification.IsRead)
                                                    {
                                        <span class="ml-1 inline-flex h-2 w-2 bg-blue-500 rounded-full"></span>
                                                    }
                                    </span>
                                </div>
                                <p class="text-sm text-gray-600 mb-3">@notification.Content</p>
                                <div class="flex flex-wrap gap-2">
                                    <a href="@Url.Action("Index", "Match", new { id = notification.RelatedItemId })"
                                       class="inline-flex items-center px-3 py-1.5 text-sm bg-blue-100 text-blue-700 rounded-md hover:bg-blue-200 transition-colors duration-200">
                                        <i class="fas fa-eye mr-1.5"></i> View Match
                                    </a>
                                    <button type="button" class="inline-flex items-center px-3 py-1.5 text-sm bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 transition-colors duration-200 dismiss-button"
                                            onclick="dismissNotification('@notification.Id')">
                                        <i class="fas fa-times mr-1.5"></i> Dismiss
                                    </button>
                                </div>
                            </div>
                        </div>
                                    break;

                                case "match_deleted":
                        <div class="flex items-start">
                            <div class="flex-shrink-0 mr-3 mt-1">
                                <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center">
                                    <i class="fas fa-calendar-times text-red-500"></i>
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex justify-between mb-1">
                                    <h3 class="text-base font-semibold text-gray-900 truncate">Match Cancelled</h3>
                                    <span class="text-xs text-gray-500">
                                        @notification.CreatedAt.ToString("MMM d, h:mm tt")
                                        @if (!notification.IsRead)
                                                    {
                                        <span class="ml-1 inline-flex h-2 w-2 bg-blue-500 rounded-full"></span>
                                                    }
                                    </span>
                                </div>
                                <p class="text-sm text-gray-600 mb-3">@notification.Content</p>
                                <div class="flex flex-wrap gap-2">
                                    <a href="@Url.Action("Index", "Match")"
                                       class="inline-flex items-center px-3 py-1.5 text-sm bg-blue-100 text-blue-700 rounded-md hover:bg-blue-200 transition-colors duration-200">
                                        <i class="fas fa-search mr-1.5"></i> Find Other Matches
                                    </a>
                                    <button type="button" class="inline-flex items-center px-3 py-1.5 text-sm bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 transition-colors duration-200 dismiss-button"
                                            onclick="dismissNotification('@notification.Id')">
                                        <i class="fas fa-times mr-1.5"></i> Dismiss
                                    </button>
                                </div>
                            </div>
                        </div>
                                    break;

                                case "match_joined":
                        <div class="flex items-start">
                            <div class="flex-shrink-0 mr-3 mt-1">
                                <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center">
                                    <i class="fas fa-user-plus text-green-500"></i>
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex justify-between mb-1">
                                    <h3 class="text-base font-semibold text-gray-900 truncate">New Match Participant</h3>
                                    <span class="text-xs text-gray-500">
                                        @notification.CreatedAt.ToString("MMM d, h:mm tt")
                                        @if (!notification.IsRead)
                                                    {
                                        <span class="ml-1 inline-flex h-2 w-2 bg-blue-500 rounded-full"></span>
                                                    }
                                    </span>
                                </div>
                                <p class="text-sm text-gray-600 mb-3">@notification.Content</p>
                                <div class="flex flex-wrap gap-2">
                                    <a href="@Url.Action("Index", "Match", new { id = notification.RelatedItemId })"
                                       class="inline-flex items-center px-3 py-1.5 text-sm bg-blue-100 text-blue-700 rounded-md hover:bg-blue-200 transition-colors duration-200">
                                        <i class="fas fa-eye mr-1.5"></i> View Match
                                    </a>
                                    <button type="button" class="inline-flex items-center px-3 py-1.5 text-sm bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 transition-colors duration-200 dismiss-button"
                                            onclick="dismissNotification('@notification.Id')">
                                        <i class="fas fa-times mr-1.5"></i> Dismiss
                                    </button>
                                </div>
                            </div>
                        </div>
                                    break;

                                case "match_request":
                        <div class="flex items-start">
                            <div class="flex-shrink-0 mr-3 mt-1">
                                <div class="w-10 h-10 rounded-full bg-purple-100 flex items-center justify-center">
                                    <i class="fas fa-question-circle text-purple-500"></i>
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex justify-between mb-1">
                                    <h3 class="text-base font-semibold text-gray-900 truncate">Match Join Request</h3>
                                    <span class="text-xs text-gray-500">
                                        @notification.CreatedAt.ToString("MMM d, h:mm tt")
                                        @if (!notification.IsRead)
                                                    {
                                        <span class="ml-1 inline-flex h-2 w-2 bg-blue-500 rounded-full"></span>
                                                    }
                                    </span>
                                </div>
                                <p class="text-sm text-gray-600 mb-3">@notification.Content</p>
                                <div class="flex flex-wrap gap-2">
                                    <a href="@Url.Action("ManageRequests", "Match", new { id = notification.RelatedItemId })"
                                       class="inline-flex items-center px-3 py-1.5 text-sm bg-green-100 text-green-700 rounded-md hover:bg-green-200 transition-colors duration-200">
                                        <i class="fas fa-check-circle mr-1.5"></i> Review Request
                                    </a>
                                    <a href="@Url.Action("Index", "Match", new { id = notification.RelatedItemId })"
                                       class="inline-flex items-center px-3 py-1.5 text-sm bg-blue-100 text-blue-700 rounded-md hover:bg-blue-200 transition-colors duration-200">
                                        <i class="fas fa-eye mr-1.5"></i> View Match
                                    </a>
                                    <button type="button" class="inline-flex items-center px-3 py-1.5 text-sm bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 transition-colors duration-200 dismiss-button"
                                            onclick="dismissNotification('@notification.Id')">
                                        <i class="fas fa-times mr-1.5"></i> Dismiss
                                    </button>
                                </div>
                            </div>
                        </div>
                                    break;

                                case "friend_request":
                        <div class="flex items-start">
                            <div class="flex-shrink-0 mr-3 mt-1">
                                <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center">
                                    <i class="fas fa-user-friends text-blue-500"></i>
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex justify-between mb-1">
                                    <h3 class="text-base font-semibold text-gray-900 truncate">Friend Request</h3>
                                    <span class="text-xs text-gray-500">
                                        @notification.CreatedAt.ToString("MMM d, h:mm tt")
                                        @if (!notification.IsRead)
                                                    {
                                        <span class="ml-1 inline-flex h-2 w-2 bg-blue-500 rounded-full"></span>
                                                    }
                                    </span>
                                </div>
                                <p class="text-sm text-gray-600 mb-3">@notification.Content</p>
                                <div class="flex flex-wrap gap-2">
                                    <form asp-action="RespondToFriendRequest" asp-route-requestId="@notification.RelatedItemId" asp-route-accept="true" method="post">
                                        <button type="submit" class="inline-flex items-center px-3 py-1.5 text-sm bg-green-100 text-green-700 rounded-md hover:bg-green-200 transition-colors duration-200">
                                            <i class="fas fa-user-check mr-1.5"></i> Accept
                                        </button>
                                    </form>
                                    <form asp-action="RespondToFriendRequest" asp-route-requestId="@notification.RelatedItemId" asp-route-accept="false" method="post">
                                        <button type="submit" class="inline-flex items-center px-3 py-1.5 text-sm bg-red-100 text-red-700 rounded-md hover:bg-red-200 transition-colors duration-200">
                                            <i class="fas fa-user-times mr-1.5"></i> Decline
                                        </button>
                                    </form>
                                    <button type="button" class="inline-flex items-center px-3 py-1.5 text-sm bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 transition-colors duration-200 dismiss-button"
                                            onclick="dismissNotification('@notification.Id')">
                                        <i class="fas fa-times mr-1.5"></i> Dismiss
                                    </button>
                                </div>
                            </div>
                        </div>
                                    break;

                                case "friend_accepted":
                        <div class="flex items-start">
                            <div class="flex-shrink-0 mr-3 mt-1">
                                <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center">
                                    <i class="fas fa-handshake text-green-500"></i>
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex justify-between mb-1">
                                    <h3 class="text-base font-semibold text-gray-900 truncate">Friend Request Accepted</h3>
                                    <span class="text-xs text-gray-500">
                                        @notification.CreatedAt.ToString("MMM d, h:mm tt")
                                        @if (!notification.IsRead)
                                                    {
                                        <span class="ml-1 inline-flex h-2 w-2 bg-blue-500 rounded-full"></span>
                                                    }
                                    </span>
                                </div>
                                <p class="text-sm text-gray-600 mb-3">@notification.Content</p>
                                <div class="flex flex-wrap gap-2">
                                    <a href="@Url.Action("Friends", "Social")"
                                       class="inline-flex items-center px-3 py-1.5 text-sm bg-blue-100 text-blue-700 rounded-md hover:bg-blue-200 transition-colors duration-200">
                                        <i class="fas fa-users mr-1.5"></i> View Friends
                                    </a>
                                    <button type="button" class="inline-flex items-center px-3 py-1.5 text-sm bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 transition-colors duration-200 dismiss-button"
                                            onclick="dismissNotification('@notification.Id')">
                                        <i class="fas fa-times mr-1.5"></i> Dismiss
                                    </button>
                                </div>
                            </div>
                        </div>
                                    break;

                                case "friend_declined":
                        <div class="flex items-start">
                            <div class="flex-shrink-0 mr-3 mt-1">
                                <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center">
                                    <i class="fas fa-user-slash text-red-500"></i>
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex justify-between mb-1">
                                    <h3 class="text-base font-semibold text-gray-900 truncate">Friend Request Declined</h3>
                                    <span class="text-xs text-gray-500">
                                        @notification.CreatedAt.ToString("MMM d, h:mm tt")
                                        @if (!notification.IsRead)
                                                    {
                                        <span class="ml-1 inline-flex h-2 w-2 bg-blue-500 rounded-full"></span>
                                                    }
                                    </span>
                                </div>
                                <p class="text-sm text-gray-600 mb-3">@notification.Content</p>
                                <div class="flex flex-wrap gap-2">
                                    <button type="button" class="inline-flex items-center px-3 py-1.5 text-sm bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 transition-colors duration-200 dismiss-button"
                                            onclick="dismissNotification('@notification.Id')">
                                        <i class="fas fa-times mr-1.5"></i> Dismiss
                                    </button>
                                </div>
                            </div>
                        </div>
                                    break;

                                case "message":
                        <div class="flex items-start">
                            <div class="flex-shrink-0 mr-3 mt-1">
                                <div class="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center">
                                    <i class="fas fa-envelope text-indigo-500"></i>
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex justify-between mb-1">
                                    <h3 class="text-base font-semibold text-gray-900 truncate">New Message</h3>
                                    <span class="text-xs text-gray-500">
                                        @notification.CreatedAt.ToString("MMM d, h:mm tt")
                                        @if (!notification.IsRead)
                                                    {
                                        <span class="ml-1 inline-flex h-2 w-2 bg-blue-500 rounded-full"></span>
                                                    }
                                    </span>
                                </div>
                                <p class="text-sm text-gray-600 mb-3">@notification.Content</p>
                                <div class="flex flex-wrap gap-2">
                                    <a href="@Url.Action("Conversation", "Social", new { id = notification.RelatedItemId })"
                                       class="inline-flex items-center px-3 py-1.5 text-sm bg-indigo-100 text-indigo-700 rounded-md hover:bg-indigo-200 transition-colors duration-200">
                                        <i class="fas fa-reply mr-1.5"></i> View Conversation
                                    </a>
                                    <button type="button" class="inline-flex items-center px-3 py-1.5 text-sm bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 transition-colors duration-200 dismiss-button"
                                            onclick="dismissNotification('@notification.Id')">
                                        <i class="fas fa-times mr-1.5"></i> Dismiss
                                    </button>
                                </div>
                            </div>
                        </div>
                                    break;

                                case "match_invite":
                        <div class="flex items-start">
                            <div class="flex-shrink-0 mr-3 mt-1">
                                <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center">
                                    <i class="fas fa-calendar-plus text-green-500"></i>
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex justify-between mb-1">
                                    <h3 class="text-base font-semibold text-gray-900 truncate">Match Invitation</h3>
                                    <span class="text-xs text-gray-500">
                                        @notification.CreatedAt.ToString("MMM d, h:mm tt")
                                        @if (!notification.IsRead)
                                                    {
                                        <span class="ml-1 inline-flex h-2 w-2 bg-blue-500 rounded-full"></span>
                                                    }
                                    </span>
                                </div>
                                <p class="text-sm text-gray-600 mb-3">@notification.Content</p>
                                <div class="flex flex-wrap gap-2">
                                    <a href="@Url.Action("Detail", "Match", new { id = notification.RelatedItemId })"
                                       class="inline-flex items-center px-3 py-1.5 text-sm bg-blue-100 text-blue-700 rounded-md hover:bg-blue-200 transition-colors duration-200">
                                        <i class="fas fa-eye mr-1.5"></i> View Match
                                    </a>
                                    <button type="button" class="inline-flex items-center px-3 py-1.5 text-sm bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 transition-colors duration-200 dismiss-button"
                                            onclick="dismissNotification('@notification.Id')">
                                        <i class="fas fa-times mr-1.5"></i> Dismiss
                                    </button>
                                </div>
                            </div>
                        </div>
                                    break;

                                case "tournament_invite":
                        <div class="flex items-start">
                            <div class="flex-shrink-0 mr-3 mt-1">
                                <div class="w-10 h-10 rounded-full bg-yellow-100 flex items-center justify-center">
                                    <i class="fas fa-trophy text-yellow-500"></i>
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex justify-between mb-1">
                                    <h3 class="text-base font-semibold text-gray-900 truncate">Tournament Invitation</h3>
                                    <span class="text-xs text-gray-500">
                                        @notification.CreatedAt.ToString("MMM d, h:mm tt")
                                        @if (!notification.IsRead)
                                                    {
                                        <span class="ml-1 inline-flex h-2 w-2 bg-blue-500 rounded-full"></span>
                                                    }
                                    </span>
                                </div>
                                <p class="text-sm text-gray-600 mb-3">@notification.Content</p>
                                <div class="flex flex-wrap gap-2">
                                    <a href="@Url.Action("Details", "Tournaments", new { id = notification.RelatedItemId })"
                                       class="inline-flex items-center px-3 py-1.5 text-sm bg-yellow-100 text-yellow-700 rounded-md hover:bg-yellow-200 transition-colors duration-200">
                                        <i class="fas fa-eye mr-1.5"></i> View Tournament
                                    </a>
                                    <button type="button" class="inline-flex items-center px-3 py-1.5 text-sm bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 transition-colors duration-200 dismiss-button"
                                            onclick="dismissNotification('@notification.Id')">
                                        <i class="fas fa-times mr-1.5"></i> Dismiss
                                    </button>
                                </div>
                            </div>
                        </div>
                                    break;

                                default:
                        <div class="flex items-start">
                            <div class="flex-shrink-0 mr-3 mt-1">
                                <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center">
                                    <i class="fas fa-bell text-gray-500"></i>
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex justify-between mb-1">
                                    <h3 class="text-base font-semibold text-gray-900 truncate">Notification</h3>
                                    <span class="text-xs text-gray-500">
                                        @notification.CreatedAt.ToString("MMM d, h:mm tt")
                                        @if (!notification.IsRead)
                                                    {
                                        <span class="ml-1 inline-flex h-2 w-2 bg-blue-500 rounded-full"></span>
                                                    }
                                    </span>
                                </div>
                                <p class="text-sm text-gray-600 mb-3">@notification.Content</p>
                                <div class="flex flex-wrap gap-2">
                                    <button type="button" class="inline-flex items-center px-3 py-1.5 text-sm bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 transition-colors duration-200 dismiss-button"
                                            onclick="dismissNotification('@notification.Id')">
                                        <i class="fas fa-times mr-1.5"></i> Dismiss
                                    </button>
                                </div>
                            </div>
                        </div>
                                    break;
                            }
                    </div>
                    }
                </div>
            }
            </div>

            <!-- Toast container for notifications -->
            <div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col space-y-2 max-w-xs"></div>

            <!-- Connection Status - Redesigned as a pill -->
            <div id="connection-status-indicator" class="fixed bottom-20 right-4 z-10 opacity-100 transition-opacity duration-500">
                <div class="flex items-center bg-white rounded-full shadow-md px-3 py-1 text-sm">
                    <span id="connection-status" class="text-red-500 font-medium">●</span>
                    <span class="ml-1.5 text-gray-600">SignalR</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Hidden notification sound element -->
    <audio id="notification-sound" preload="auto" src="/sounds/notification.mp3"></audio>

    <!-- User data for SignalR -->
    <div id="user-data"
         data-current-user-id="@currentUserId"
         class="hidden"></div>

    @section Scripts {
        <script type="text/javascript">
            // Enhanced dismiss function with animation
            function dismissNotification(notificationId) {
                console.log('Dismissing notification: ' + notificationId);

                // Get the card element
                var card = document.getElementById('notification-' + notificationId);
                if (!card) {
                    console.error('Card not found');
                    return;
                }

                // Visual feedback - add a dismissing class
                card.classList.add('dismissing');
                card.style.opacity = '0.6';
                card.style.transform = 'translateX(10px)';

                // Create form data
                var formData = new FormData();
                formData.append('notificationId', notificationId);

                // Make the fetch request
                fetch('/Social/DeleteNotification?notificationId=' + notificationId, {
                    method: 'POST',
                    body: formData
                })
                    .then(function (response) {
                        // Enhance animation
                        card.style.opacity = '0';
                        card.style.transform = 'translateX(100%)';

                        // Remove after animation
                        setTimeout(function () {
                            card.remove();

                            // Check if container is empty
                            var container = document.getElementById('notifications-container');
                            if (container && container.children.length === 0) {
                                container.innerHTML = '<div class="flex flex-col items-center justify-center py-16 px-4"><div class="bg-gray-100 rounded-full p-4 mb-4"><i class="fas fa-bell-slash text-3xl text-gray-400"></i></div><p class="text-gray-500 text-center">You don\'t have any notifications yet.</p><p class="text-gray-400 text-sm text-center mt-2">When you receive notifications, they\'ll appear here.</p></div>';
                            }
                        }, 300);
                    })
                    .catch(function (error) {
                        console.error('Error: ', error);
                        // Restore on error
                        card.style.opacity = '1';
                        card.style.transform = 'none';
                        card.classList.remove('dismissing');
                    });
            }

            // Function to show toast notifications
            function showToast(title, message, type = 'info') {
                // Create container if it doesn't exist
                let toastContainer = document.getElementById('toast-container');
                if (!toastContainer) {
                    toastContainer = document.createElement('div');
                    toastContainer.id = 'toast-container';
                    toastContainer.className = 'fixed top-4 right-4 z-50 flex flex-col space-y-2 max-w-xs';
                    document.body.appendChild(toastContainer);
                }

                // Create toast with appropriate styling based on type
                const toast = document.createElement('div');
                let iconClass, bgClass, textClass;

                switch (type) {
                    case 'success':
                        iconClass = 'fa-check-circle text-green-500';
                        bgClass = 'bg-green-50 border-green-200';
                        textClass = 'text-green-800';
                        break;
                    case 'warning':
                        iconClass = 'fa-exclamation-triangle text-yellow-500';
                        bgClass = 'bg-yellow-50 border-yellow-200';
                        textClass = 'text-yellow-800';
                        break;
                    case 'error':
                        iconClass = 'fa-exclamation-circle text-red-500';
                        bgClass = 'bg-red-50 border-red-200';
                        textClass = 'text-red-800';
                        break;
                    default:
                        iconClass = 'fa-info-circle text-blue-500';
                        bgClass = 'bg-blue-50 border-blue-200';
                        textClass = 'text-blue-800';
                }

                toast.className = `${bgClass} border rounded-lg shadow-lg p-4 transform translate-x-full transition-transform duration-300 flex items-start`;

                toast.innerHTML = `
                        <div class="flex-shrink-0 mr-3">
                            <i class="fas ${iconClass} text-lg"></i>
                        </div>
                        <div class="flex-1">
                            <div class="font-medium ${textClass}">${title}</div>
                            <div class="text-sm text-gray-600 mt-1">${message}</div>
                        </div>
                        <button class="ml-4 text-gray-400 hover:text-gray-600 focus:outline-none" onclick="this.parentElement.remove()">
                            <i class="fas fa-times"></i>
                        </button>
                    `;

                // Add to container
                toastContainer.appendChild(toast);

                // Animate in
                setTimeout(() => {
                    toast.classList.remove('translate-x-full');
                }, 10);

                // Auto-remove after 5 seconds
                setTimeout(() => {
                    toast.classList.add('translate-x-full');
                    setTimeout(() => {
                        if (toast.parentElement) {
                            toast.remove();
                        }
                    }, 300);
                }, 5000);
            }

            // Apply theme colors to buttons and other elements
            function applyThemeToElements() {
                // Get the current theme
                const currentTheme = document.getElementById('theme-data').getAttribute('data-theme');

                // Define theme colors directly
                const themeColors = {
                    'Wimbledon': { primary: '#64408a', text: '#ffffff' },
                    'RolandGarros': { primary: '#084e2e', text: '#ffffff' },
                    'USOpen': { primary: '#426892', text: '#ffffff' },
                    'AustralianOpen': { primary: '#e9f7ff', text: '#000000' }
                };

                // Get colors for the current theme
                const themeColor = themeColors[currentTheme]?.primary || themeColors['Wimbledon'].primary;
                const textColor = themeColors[currentTheme]?.text || themeColors['Wimbledon'].text;

                // Apply to theme-header elements
                document.querySelectorAll('.theme-header').forEach(header => {
                    header.style.backgroundColor = themeColor;
                });

                // Apply to theme-text elements
                document.querySelectorAll('.theme-text').forEach(text => {
                    text.style.color = textColor;
                });

                // Apply to theme-card elements - add subtle hover effect
                document.querySelectorAll('.theme-card').forEach(card => {
                    const originalBoxShadow = card.style.boxShadow;

                    card.addEventListener('mouseenter', function () {
                        this.style.borderColor = themeColor;
                        this.style.boxShadow = `0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05), 0 0 0 2px ${themeColor}20`;
                    });

                    card.addEventListener('mouseleave', function () {
                        this.style.borderColor = '';
                        this.style.boxShadow = originalBoxShadow;
                    });
                });
            }

            document.addEventListener('DOMContentLoaded', function () {
                console.log('DOM loaded - initializing social page');

                // Apply theme colors
                applyThemeToElements();

                // Update connection status styles
                const connectionStatus = document.getElementById('connection-status');
                if (connectionStatus) {
                    // Function to update connection status
                    window.updateConnectionStatus = function (isConnected) {
                        if (isConnected) {
                            connectionStatus.className = 'text-green-500 font-medium';
                            connectionStatus.textContent = '●';
                        } else {
                            connectionStatus.className = 'text-red-500 font-medium';
                            connectionStatus.textContent = '●';
                        }
                    };
                }

                // Hide connection status after delay
                setTimeout(function () {
                    const indicator = document.getElementById('connection-status-indicator');
                    if (indicator) {
                        indicator.style.opacity = '0';
                        setTimeout(function () {
                            indicator.style.display = 'none';
                        }, 500);
                    }
                }, 5000);

                // Store the user ID in sessionStorage for SignalR
                const userData = document.getElementById('user-data');
                if (userData) {
                    const userId = userData.getAttribute('data-current-user-id');
                    if (userId) {
                        sessionStorage.setItem('userId', userId);
                        console.log('Set user ID for SignalR:', userId);
                    }
                }

                // Add smooth scrolling to notification container
                const container = document.getElementById('notifications-container');
                if (container) {
                    container.classList.add('scrollbar-thin', 'scrollbar-thumb-gray-300', 'scrollbar-track-transparent');
                }

                // Test toast notification if in development
                if (window.location.hostname === 'localhost') {
                    document.getElementById('test-notification-btn')?.addEventListener('click', function () {
                        showToast('Test Notification', 'This is a test notification message', 'info');
                    });
                }
            });

            // Listen for theme changes
            window.addEventListener('themeChanged', function (e) {
                if (e.detail && e.detail.theme) {
                    document.getElementById('theme-data').setAttribute('data-theme', e.detail.theme);
                }
                applyThemeToElements();
            });
        </script>
    }
